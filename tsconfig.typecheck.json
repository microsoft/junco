{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "customConditions": ["dataflow-no-tracing"],
    "paths": { "dataflow-engine": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"],
  "exclude": ["examples/tracing-opik.ts", "**/node_modules/**", "**/dist/**"]
}
