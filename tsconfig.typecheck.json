{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "noEmit": true,
    "paths": {
      "junco": ["./src/index.ts"]
    },
    "declaration": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "examples/**/*.ts",
    "install.ts",
    "ci/run-tests.ts"
  ]
}
