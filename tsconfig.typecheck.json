{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "noEmit": true,
    "paths": {
      "junco-agency": ["./src/index.ts"],
      "junco-agency/workflows": ["./src/workflows/index.ts"],
      "junco-syntax": ["./packages/junco-syntax/src/index.ts"]
    },
    "declaration": false,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"]
}
