{
  "name": "dataflow-engine",
  "version": "0.1.0",
  "description": "Async generator dataflow graph runtime with a pluggable scheduler, over ngraph.graph.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run --cwd ../share build && tsc -p tsconfig.json",
    "typecheck": "bun run --cwd ../share build && tsc -p tsconfig.typecheck.json",
    "test": "bun test ./tests/*.test.ts ./tests/*.example.ts"
  },
  "dependencies": {
    "fp-ts": "^2.16.11",
    "ngraph.graph": "^20.1.2",
    "share": "workspace:*",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "fast-check": "^4.8.0",
    "typescript": "6.0.3"
  }
}
