{
  "name": "junco-agency",
  "version": "0.1.0",
  "private": true,
  "description": "Recursive Pi agencies: typed work graphs paired with composable scheduling policies.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "packages/dataflow-engine/examples"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --root ./src --outdir ./dist --target node --format esm --packages external --splitting --sourcemap=external && tsc -p tsconfig.json --emitDeclarationOnly",
    "build:examples": "bun build ./examples/recursive-agency/recursive-agency.ts ./examples/mixed/mixed.ts ./examples/oss-committee/oss-committee.ts ./examples/mcp/mcp.ts ./examples/yak-shaver/yak-shaver.ts ./examples/verus/verus.ts --root ./examples --outdir ./examples/dist --target bun --format esm --packages bundle --splitting --sourcemap=external --env=disable --external junco-tools/native --external @oh-my-pi/pi-coding-agent --external @earendil-works/pi-agent-core --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check": "bun run --bun biome check .",
    "check:ci": "bun run --bun biome ci .",
    "test": "bun test ./test/mock-agent.test.ts ./test/agent-node.test.ts ./test/deterministic-agency.test.ts ./test/compaction.test.ts ./test/deterministic.test.ts ./test/std-namespaces.test.ts ./test/map.test.ts ./test/spawn.test.ts ./test/task.test.ts ./test/tui-graph.test.ts ./test/complain.test.ts ./test/agency.test.ts ./test/resource-schedulers.test.ts ./test/profile-recorder.test.ts ./test/syntax-parse.test.ts ./test/syntax-build.test.ts ./test/syntax-examples.test.ts",
    "test:coverage": "bun run test --coverage",
    "test:integration": "bun test ./test/junco-agency.test.ts ./test/scheduler-dsl.test.ts ./test/oss-committee.test.ts ./test/mixed.test.ts ./test/std-workflows.test.ts ./test/yak-shaver.test.ts ./test/verus.test.ts",
    "test:native": "bun test ./test/policy-yield.test.ts ./test/mcp-graphs.test.ts ./test/yak-shaver-native.test.ts ./test/tui-tracer.test.ts ./test/profile-recorder-native.test.ts",
    "test:all": "bun run test && bun run test:integration && bun run test:native",
    "smoke": "bun run test/deterministic-agency.fixture.ts",
    "smoke:deterministic": "node --experimental-strip-types ./test/deterministic-agency.fixture.ts",
    "smoke:deterministic:bun": "bun run ./test/deterministic-agency.fixture.ts",
    "smoke:pi": "bun run examples/recursive-agency/recursive-agency.ts",
    "smoke:tui": "bun run test/tui-tracer.fixture.ts",
    "smoke:workflows": "node --experimental-strip-types ./test/workflows.fixture.ts",
    "smoke:workflows:bun": "bun run ./test/workflows.fixture.ts",
    "postinstall": "if [ -x \"${CARGO_HOME:-$HOME/.local/share/junco-tools/cargo}/bin/cargo\" ]; then cd packages/junco-tools && bun run build:native; else echo 'postinstall: no Rust toolchain for junco-tools (see packages/junco-tools/README.md); skipped its native addon' >&2; fi"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "dataflow-engine": "workspace:*",
    "dataflow-profile": "workspace:*",
    "fp-ts": "^2.16.11",
    "junco-agent": "workspace:*",
    "junco-mcp": "workspace:*",
    "junco-scheduler": "workspace:*",
    "junco-tools": "workspace:*",
    "ngraph.graph": "^20.1.2",
    "mermaid-ascii": "1.0.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nanonets/graft": "0.21.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "dataflow-engine-opik": "workspace:*",
    "typescript": "7.0.2"
  },
  "overrides": {
    "junco-agency": "file:.",
    "@earendil-works/pi-agent-core": "0.99.2",
    "typebox": "1.3.34"
  },
  "patchedDependencies": {
    "mermaid-ascii@1.0.0": "patches/mermaid-ascii@1.0.0.patch"
  }
}
