{
  "name": "junco-agency",
  "version": "0.1.0",
  "private": true,
  "description": "Recursive Pi agencies: dataflow graphs of Agentic members driven by one schedule-only Pi scheduler.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test ./test/*.test.ts",
    "smoke": "bun run examples/recursive-agency.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "dataflow-engine": "file:../dataflow-engine",
    "fp-ts": "^2.16.11",
    "junco-agent": "file:../junco-agent",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.0.1",
    "junco-tools": "file:../junco-tools",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.80.6"
  },
  "patchedDependencies": {
    "@earendil-works/pi-agent-core@0.80.6": "../junco-agent/patches/@earendil-works%2Fpi-agent-core@0.80.6.patch"
  }
}
