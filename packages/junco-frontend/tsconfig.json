{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "server",
    "outDir": "dist/server",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["server/**/*.ts"]
}
