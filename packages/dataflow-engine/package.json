{
  "name": "dataflow-engine",
  "version": "0.1.0",
  "description": "Async-generator dataflow engine for TypeScript with pluggable schedulers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/junco.git",
    "directory": "packages/dataflow-engine"
  },
  "homepage": "https://github.com/microsoft/junco/tree/main/packages/dataflow-engine#readme",
  "bugs": {
    "url": "https://github.com/microsoft/junco/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --packages external --sourcemap=external && bun run tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "bun run tsc -p tsconfig.typecheck.json",
    "test": "bun --conditions=dataflow-no-tracing test ./tests/*.test.ts ./tests/*.example.ts",
    "test:coverage": "bun --conditions=dataflow-no-tracing test --coverage ./tests/*.test.ts ./tests/*.example.ts",
    "example:fibonacci": "bun run examples/run.ts fibonacci",
    "example:multiplier": "bun run examples/run.ts multiplier",
    "example:word-count": "bun run examples/run.ts word-count",
    "example:combine-per-key": "bun run examples/run.ts combine-per-key",
    "example:memory-limit": "bun run examples/run.ts memory-limit",
    "example:token-race": "bun run examples/run.ts token-race",
    "examples": "bun run examples/run.ts",
    "examples:cookbook": "bun run examples/run.ts --cookbook",
    "examples:build": "bun run examples/build.ts",
    "examples:typecheck": "bun run tsc -p examples/tsconfig.json",
    "lint": "bun run --bun biome lint .",
    "format": "bun run --bun biome format --write .",
    "check": "bun run --bun biome check .",
    "check:ci": "bun run --bun biome ci ."
  },
  "dependencies": {
    "@buge/ts-units": "^1.2.3",
    "fp-ts": "^2.16.11",
    "ngraph.graph": "^20.1.2",
    "prettier-printer": "^1.1.4",
    "type-fest": "^5.10.0",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.6",
    "fast-check": "^4.10.2",
    "junco-scheduler": "workspace:*",
    "typescript": "7.0.2"
  }
}
