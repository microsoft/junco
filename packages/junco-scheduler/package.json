{
  "name": "junco-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Typed dataflow scheduler DSL, external execution contexts, and an optional Pi model oracle.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "bun": "./src/agent.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:core": "rm -rf dist && tsc -p tsconfig.core.json",
    "typecheck:core": "tsc -p tsconfig.core.typecheck.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "bun test ./test/*.test.ts",
    "test:coverage": "bun run test --coverage"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "dataflow-engine": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "dataflow-engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "dataflow-engine": "workspace:*",
    "fast-check": "^4.10.2",
    "typescript": "7.0.2"
  }
}
