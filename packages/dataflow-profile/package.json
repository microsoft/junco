{
  "name": "dataflow-profile",
  "version": "0.1.0",
  "description": "Profile data structs, fitting and persistence for profiling-guided dataflow-engine scheduling.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "bun": "./src/index.ts", "import": "./dist/index.js" } },
  "files": ["dist", "src", "schemas", "LICENSE"],
  "bin": { "profile-fit": "./src/cli.ts" },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --packages external --sourcemap=external && bun run tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "bun run tsc -p tsconfig.typecheck.json",
    "test": "bun test ./tests/*.test.ts",
    "fit": "bun run src/cli.ts",
    "schemas": "bun run scripts/emit-schemas.ts"
  },
  "dependencies": { "@buge/ts-units": "^1.2.3", "typebox": "1.3.34" },
  "peerDependencies": { "dataflow-engine": "^0.1.0" },
  "devDependencies": {
    "@types/bun": "1.4.2", "@types/node": "26.6.3", "dataflow-engine": "workspace:*",
    "junco-scheduler": "workspace:*",
    "fast-check": "^4.10.2", "typescript": "7.0.2"
  }
}
