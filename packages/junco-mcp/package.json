{
  "name": "junco-mcp",
  "version": "0.1.0",
  "description": "Declarative MCP stdio tool collections for Junco agents, run through the shared Junco ShellMux.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./test/*.test.ts",
    "test:native": "bun test ./test/native"
  },
  "dependencies": {
    "junco-tools": "workspace:*",
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-mcp": "0.99.2",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
