{
  "name": "junco-syntax",
  "version": "0.1.0",
  "description": "Declarative YAML syntax and runnable Junco graphs.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --packages external --sourcemap=external && bun run tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "bun run tsc -p tsconfig.typecheck.json",
    "test": "bun test ./tests/*.test.ts",
    "test:coverage": "bun test --coverage ./tests/*.test.ts"
  },
  "dependencies": {
    "typebox": "1.3.34",
    "fp-ts": "^2.16.11",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2"
  },
  "peerDependencies": {
    "junco-agency": "^0.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "junco-agency": "file:../.."
  }
}
