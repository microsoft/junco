{
  "name": "junco-tools",
  "version": "0.1.0",
  "description": "Pi bash operations backed by marsh ShellMux",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./ts/index.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "bun": "./ts/errors.ts",
      "import": "./dist/errors.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "bun": "./ts/extension.ts",
      "import": "./dist/extension.js"
    },
    "./native": {
      "types": "./native/index.d.ts",
      "import": "./native/index.js"
    }
  },
  "files": [
    "dist",
    "ts",
    "native",
    "README.md",
    "LICENSE.oh-my-pi"
  ],
  "scripts": {
    "build:native": "node scripts/with-junco-build-env.mjs napi build --platform --release --esm --output-dir native --js index.js --dts index.d.ts -- --locked",
    "build:native:test": "node scripts/with-junco-build-env.mjs napi build --platform --esm --features test-fs --output-dir target/native-test --js index.js --dts index.d.ts -- --locked",
    "build:ts": "tsc -p tsconfig.json",
    "build": "bun run build:native && bun run build:ts",
    "test": "timeout --signal=TERM --kill-after=5s 900s node --test --test-concurrency=1 tests/bash.test.mjs tests/agent.test.mjs tests/tools.test.mjs",
    "test:btrfs": "node scripts/test-btrfs.mjs"
  },
  "napi": {
    "binaryName": "junco_tools",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.2.11",
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@napi-rs/cli": "3.10.5",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
