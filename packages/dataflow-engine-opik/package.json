{
  "name": "dataflow-engine-opik",
  "version": "0.1.0",
  "description": "Opik execution tracing for dataflow-engine.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "LICENSE"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --packages external --sourcemap=external && bun run tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "bun run tsc -p tsconfig.typecheck.json",
    "test": "bun test ./tests/*.test.ts",
    "pack": "bun run build && bun pm pack --destination ./pack"
  },
  "dependencies": {
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "dataflow-engine": "^0.1.0",
    "opik": "^2.2.86"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.6",
    "dataflow-engine": "workspace:*",
    "opik": "2.2.131",
    "typescript": "7.0.2"
  }
}
