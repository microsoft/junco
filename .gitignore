node_modules/
dist/
coverage/
/examples/ralph-optimizer/sort

# Python bytecode is generated by the benchmark tests.
__pycache__/
*.py[cod]

# Native build transaction journals and ownership locks are local, never source.
.napi-rs-filesystem-*

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/.trail/cache/
.claude/*
.trail/*

# Local code-exploration index (live SQLite database) — regenerable, not committed.
/.explore/

# Local omp project config at any depth (skills are installed there as links to skills/).
.omp/

# junco-tools' code_graph cache — regenerable, not committed.
.junco/

# Default ComplainBackend output (tests write it wherever they run).
complaints.jsonl
