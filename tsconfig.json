{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker.ImportScripts", "ScriptHost", "DOM.Iterable", "DOM.AsyncIterable", "ES2024.Promise"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts"]
}
