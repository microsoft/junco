+import type { AssistantMessage, ToolResultMessage } from "@earendil-works/pi-ai";
+import type { AgentTool, AgentToolCall, AgentToolResult } from "./dist/types.ts";
+/**
+ * Revision of the per-run observer contract that the junco-agent integration patch adds to
+ * AgentHarness and the agent loop. Consumers compare it when they load so that an absent or
+ * mismatched patch fails immediately instead of running unobserved.
+ */
+export declare const AGENTIC_INTEGRATION_REVISION: "junco-agentic-integration/1";
+/** The native AgentHarness method that admitted an instrumented run. */
+export type AgentRunKind = "prompt" | "skill" | "promptFromTemplate";
+/** Settlement of one tool's actual `execute` promise: its result, or exactly the value it threw. */
+export type AgentToolOutcome = {
+    readonly ok: true;
+    readonly value: AgentToolResult<unknown>;
+} | {
+    readonly ok: false;
+    readonly error: unknown;
+};
+/**
+ * Observer for exactly one admitted native run, created by `AgentHarness.createRunIntegration`.
+ *
+ * Every callback except `afterTurn` is synchronous, internal and must not throw. Callbacks never
+ * replace tools, providers, messages, events or errors; they only observe them.
+ */
+export interface AgentRunIntegration {
+    /** The run's native AbortController is installed; `signal` is its original signal. */
+    controller(signal: AbortSignal): void;
+    /** A complete assistant message, after message_end delivery, is about to execute `toolCalls`. */
+    beforeTools(message: AssistantMessage, toolCalls: readonly AgentToolCall[]): void;
+    /** The original `tool.execute` promise settled with a result or a thrown value. */
+    toolOutcome(message: AssistantMessage, tool: AgentTool<any>, toolCall: AgentToolCall, args: unknown, outcome: AgentToolOutcome): void;
+    /** A started parallel tool worker or tool-update emission; registered, never awaited. */
+    track(work: Promise<unknown>): void;
+    /**
+     * A normal turn ended after every turn_end subscriber, session write and save point. A returned
+     * promise gates the next turn preparation and provider request.
+     */
+    afterTurn(message: AssistantMessage, toolResults: ToolResultMessage[]): Promise<void> | undefined;
+    /** The low-level run rejected; native failure reporting follows. */
+    abandoned(): void;
+}
